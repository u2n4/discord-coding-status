# Optional environment overrides for local development.
# Normal setup writes compact JSON to ~/discord-coding-status/config.json.

# Discord shows only the tool's name and one model line; there are no display settings.

# Source for the terminal-only `quota` command: oauth, rpc, auto or off.
DISCORD_CODING_STATUS_CODEX_QUOTA_SOURCE=oauth

# Advanced runtime controls. Polling is a fallback; hook state changes are also watched immediately.
# DISCORD_CODING_STATUS_POLL_INTERVAL_MS=10000
# DISCORD_CODING_STATUS_PROCESS_DETECTION=on
# Process detection only reports a tool while its process shows recent activity.
# DISCORD_CODING_STATUS_PROCESS_IDLE_GRACE_MS=300000
# DISCORD_CODING_STATUS_PROCESS_ACTIVE_CPU_MS=50
# CLAUDE_CONFIG_DIR=~/.claude
# DISCORD_CODING_STATUS_CLAUDE_KEYCHAIN=on

# Only set these when you want to override the built-in Discord applications
# (DISCORD_CODING_STATUS_<TOOL>_CLIENT_ID for CODEX, CLAUDE, ANTIGRAVITY,
# CURSOR, GROK, MUSE, OPENCODE, PI).
# DISCORD_CODING_STATUS_OPENCODE_CLIENT_ID=1538957549364322404
# DISCORD_CODING_STATUS_PI_CLIENT_ID=1538957711503396986
# DISCORD_CODING_STATUS_OPENCODE_IMAGE_KEY=opencode
# DISCORD_CODING_STATUS_PI_IMAGE_KEY=pi
# DISCORD_CODING_STATUS_STATE_FILE=~/discord-coding-status/states.json
